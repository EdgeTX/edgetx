 953:/workspaces/edgetx-sw/radio/src/thirdparty/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2c.c ****                       ##### IO operation functions #####
 954:/workspaces/edgetx-sw/radio/src/thirdparty/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2c.c ****  ===============================================================================
 955:/workspaces/edgetx-sw/radio/src/thirdparty/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2c.c ****     [..]
 956:/workspaces/edgetx-sw/radio/src/thirdparty/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2c.c ****     This subsection provides a set of functions allowing to manage the I2C data
 957:/workspaces/edgetx-sw/radio/src/thirdparty/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2c.c ****     transfers.
 958:/workspaces/edgetx-sw/radio/src/thirdparty/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2c.c **** 
 959:/workspaces/edgetx-sw/radio/src/thirdparty/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2c.c ****     (#) There are two modes of transfer:
 960:/workspaces/edgetx-sw/radio/src/thirdparty/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2c.c ****        (++) Blocking mode : The communication is performed in the polling mode.
 961:/workspaces/edgetx-sw/radio/src/thirdparty/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2c.c ****             The status of all data processing is returned by the same function
 962:/workspaces/edgetx-sw/radio/src/thirdparty/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2c.c ****             after finishing transfer.
 963:/workspaces/edgetx-sw/radio/src/thirdparty/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2c.c ****        (++) No-Blocking mode : The communication is performed using Interrupts
 964:/workspaces/edgetx-sw/radio/src/thirdparty/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2c.c ****             or DMA. These functions return the status of the transfer startup.
 965:/workspaces/edgetx-sw/radio/src/thirdparty/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2c.c ****             The end of the data processing will be indicated through the
 966:/workspaces/edgetx-sw/radio/src/thirdparty/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2c.c ****             dedicated I2C IRQ when using Interrupt mode or the DMA IRQ when
 967:/workspaces/edgetx-sw/radio/src/thirdparty/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2c.c ****             using DMA mode.
 968:/workspaces/edgetx-sw/radio/src/thirdparty/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2c.c **** 
 969:/workspaces/edgetx-sw/radio/src/thirdparty/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2c.c ****     (#) Blocking mode functions are :
 970:/workspaces/edgetx-sw/radio/src/thirdparty/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2c.c ****         (++) HAL_I2C_Master_Transmit()
 971:/workspaces/edgetx-sw/radio/src/thirdparty/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2c.c ****         (++) HAL_I2C_Master_Receive()
 972:/workspaces/edgetx-sw/radio/src/thirdparty/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2c.c ****         (++) HAL_I2C_Slave_Transmit()
 973:/workspaces/edgetx-sw/radio/src/thirdparty/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2c.c ****         (++) HAL_I2C_Slave_Receive()
 974:/workspaces/edgetx-sw/radio/src/thirdparty/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2c.c ****         (++) HAL_I2C_Mem_Write()
 975:/workspaces/edgetx-sw/radio/src/thirdparty/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2c.c ****         (++) HAL_I2C_Mem_Read()
 976:/workspaces/edgetx-sw/radio/src/thirdparty/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2c.c ****         (++) HAL_I2C_IsDeviceReady()
 977:/workspaces/edgetx-sw/radio/src/thirdparty/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2c.c **** 
 978:/workspaces/edgetx-sw/radio/src/thirdparty/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2c.c ****     (#) No-Blocking mode functions with Interrupt are :
 979:/workspaces/edgetx-sw/radio/src/thirdparty/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2c.c ****         (++) HAL_I2C_Master_Transmit_IT()
 980:/workspaces/edgetx-sw/radio/src/thirdparty/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2c.c ****         (++) HAL_I2C_Master_Receive_IT()
 981:/workspaces/edgetx-sw/radio/src/thirdparty/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2c.c ****         (++) HAL_I2C_Slave_Transmit_IT()
 982:/workspaces/edgetx-sw/radio/src/thirdparty/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2c.c ****         (++) HAL_I2C_Slave_Receive_IT()
 983:/workspaces/edgetx-sw/radio/src/thirdparty/STM32F4xx_HAL_Driver/Src/stm32f4xx_hal_i2c.c ****         (++) HAL_I2C_Mem_Write_IT()
