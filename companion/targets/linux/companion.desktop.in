[Desktop Entry]
Type=Application
Name=EdgeTX Companion @VERSION@
GenericName=Transmitter Companion App
Comment=The Ultimate Transmitter Companion
Icon=@COMPANION_NAME@
Exec=@COMPANION_NAME@
Terminal=false
StartupWMClass=EdgeTX Companion
StartupNotify=false
Categories=Utility;
Actions=Simulator;

# AppImage integrators (libappimage) point each action's Exec at the AppImage, whose AppRun
# routes --simulator to the bundled simulator
[Desktop Action Simulator]
Name=EdgeTX Simulator
Exec=@COMPANION_NAME@ --simulator
