{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "hidden": true,
      "cacheVariables": {
        "FETCHCONTENT_BASE_DIR": "${sourceDir}/.cache/fetchcontent"
      },
      "warnings": {
        "dev": false
      }
    },
    {
      "name": "firmware",
      "hidden": true,
      "inherits": "default",
      "binaryDir": "build/${presetName}",
      "toolchainFile": "cmake/toolchain/arm-none-eabi.cmake",
      "cacheVariables": {
        "EdgeTX_SUPERBUILD": false,
        "NATIVE_BUILD": false
      }
    },
    {
      "name": "native",
      "hidden": true,
      "inherits": "default",
      "binaryDir": "build/${presetName}",
      "toolchainFile": "cmake/toolchain/native.cmake",
      "cacheVariables": {
        "EdgeTX_SUPERBUILD": false,
        "NATIVE_BUILD": true
      }
    },
    {
      "name": "companion",
      "displayName": "Companion",
      "inherits": "native",
      "binaryDir": "build/companion"
    },
    {
      "name": "simu",
      "displayName": "SDL Simulator",
      "inherits": "native",
      "binaryDir": "build/simu"
    },

    {
      "name": "f16",
      "displayName": "Fatfish F16",
